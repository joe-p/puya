main test_cases.nested_loops.contract.Nested.approval_program:
    block@0: // L7
        let x#0: uint64 = 0u
        let next_range_item#0: uint64 = 0u
        goto block@1
    block@1: // for_header_L11
        let next_range_item#1: uint64 = φ(next_range_item#0 <- block@0, next_range_item#17 <- block@22)
        let x#7: uint64 = φ(x#0 <- block@0, x#6 <- block@22)
        let continue_looping%0#0: bool = (< next_range_item#1 2u)
        goto continue_looping%0#0 ? block@2 : block@24
    block@2: // for_body_L12
        let next_range_item#2: uint64 = 0u
        goto block@3
    block@3: // for_header_L12
        let next_range_item#3: uint64 = φ(next_range_item#2 <- block@2, next_range_item#16 <- block@20)
        let x#6: uint64 = φ(x#7 <- block@2, x#5 <- block@20)
        let continue_looping%1#0: bool = (< next_range_item#3 2u)
        goto continue_looping%1#0 ? block@4 : block@22
    block@4: // for_body_L13
        let next_range_item#4: uint64 = 0u
        goto block@5
    block@5: // for_header_L13
        let next_range_item#5: uint64 = φ(next_range_item#4 <- block@4, next_range_item#15 <- block@18)
        let x#5: uint64 = φ(x#6 <- block@4, x#4 <- block@18)
        let continue_looping%2#0: bool = (< next_range_item#5 2u)
        goto continue_looping%2#0 ? block@6 : block@20
    block@6: // for_body_L14
        let next_range_item#6: uint64 = 0u
        goto block@7
    block@7: // for_header_L14
        let next_range_item#7: uint64 = φ(next_range_item#6 <- block@6, next_range_item#14 <- block@16)
        let x#4: uint64 = φ(x#5 <- block@6, x#3 <- block@16)
        let continue_looping%3#0: bool = (< next_range_item#7 2u)
        goto continue_looping%3#0 ? block@8 : block@18
    block@8: // for_body_L15
        let next_range_item#8: uint64 = 0u
        goto block@9
    block@9: // for_header_L15
        let next_range_item#9: uint64 = φ(next_range_item#8 <- block@8, next_range_item#13 <- block@14)
        let x#3: uint64 = φ(x#4 <- block@8, x#1 <- block@14)
        let continue_looping%4#0: bool = (< next_range_item#9 2u)
        goto continue_looping%4#0 ? block@10 : block@16
    block@10: // for_body_L16
        let next_range_item#10: uint64 = 0u
        goto block@11
    block@11: // for_header_L16
        let next_range_item#11: uint64 = φ(next_range_item#10 <- block@10, next_range_item#12 <- block@12)
        let x#1: uint64 = φ(x#3 <- block@10, x#2 <- block@12)
        let continue_looping%5#0: bool = (< next_range_item#11 2u)
        goto continue_looping%5#0 ? block@12 : block@14
    block@12: // for_body_L17
        let tmp%0#0: uint64 = (+ next_range_item#1 next_range_item#3)
        let tmp%1#0: uint64 = (+ tmp%0#0 next_range_item#5)
        let tmp%2#0: uint64 = (+ tmp%1#0 next_range_item#7)
        let tmp%3#0: uint64 = (+ tmp%2#0 next_range_item#9)
        let tmp%4#0: uint64 = (+ tmp%3#0 next_range_item#11)
        let x#2: uint64 = (+ x#1 tmp%4#0)
        let next_range_item#12: uint64 = (+ next_range_item#11 1u)
        goto block@11
    block@14: // after_for_L16
        let next_range_item#13: uint64 = (+ next_range_item#9 1u)
        goto block@9
    block@16: // after_for_L15
        let next_range_item#14: uint64 = (+ next_range_item#7 1u)
        goto block@7
    block@18: // after_for_L14
        let next_range_item#15: uint64 = (+ next_range_item#5 1u)
        goto block@5
    block@20: // after_for_L13
        let next_range_item#16: uint64 = (+ next_range_item#3 1u)
        goto block@3
    block@22: // after_for_L12
        let next_range_item#17: uint64 = (+ next_range_item#1 1u)
        goto block@1
    block@24: // after_for_L11
        let tmp%5#0: bytes = (itob x#7)
        (log tmp%5#0)
        let y#0: uint64 = 0u
        let index#0: uint64 = 0u
        let next_range_item#18: uint64 = 0u
        goto block@25
    block@25: // for_header_L25
        let index#1: uint64 = φ(index#0 <- block@24, index#2 <- block@26)
        let next_range_item#19: uint64 = φ(next_range_item#18 <- block@24, next_range_item#20 <- block@26)
        let y#1: uint64 = φ(y#0 <- block@24, y#2 <- block@26)
        let continue_looping%6#0: bool = (< next_range_item#19 10u)
        goto continue_looping%6#0 ? block@26 : block@28
    block@26: // for_body_L26
        let tmp%6#0: uint64 = (* next_range_item#19 index#1)
        let y#2: uint64 = (+ y#1 tmp%6#0)
        let next_range_item#20: uint64 = (+ next_range_item#19 1u)
        let index#2: uint64 = (+ index#1 1u)
        goto block@25
    block@28: // after_for_L25
        let tmp%7#0: bytes = (itob y#1)
        (log tmp%7#0)
        return x#7