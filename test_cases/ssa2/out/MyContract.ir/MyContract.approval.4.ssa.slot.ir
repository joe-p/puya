main test_cases.ssa2.contract.MyContract.approval_program:
    block@0: // L7
        let a#0: uint64 = 3u
        let b#0: uint64 = 20u
        let next_range_item#0: uint64 = 0u
        goto block@1
    block@1: // for_header_L15
        let next_range_item#1: uint64 = φ(next_range_item#0 <- block@0, next_range_item#2 <- block@2)
        let b#1: uint64 = φ(b#0 <- block@0, b#2 <- block@2)
        let a#1: uint64 = φ(a#0 <- block@0, a#2 <- block@2)
        let continue_looping%0#0: bool = (< next_range_item#1 5u)
        goto continue_looping%0#0 ? block@2 : block@4
    block@2: // for_body_L16
        let b#2: uint64 = (+ b#1 a#1)
        let a#2: uint64 = (+ a#1 next_range_item#1)
        let next_range_item#2: uint64 = (+ next_range_item#1 1u)
        goto block@1
    block@4: // after_for_L15
        let tmp%0#0: uint64 = (+ a#1 b#1)
        return tmp%0#0