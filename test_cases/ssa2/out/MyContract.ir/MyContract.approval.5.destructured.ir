main test_cases.ssa2.contract.MyContract.approval_program:
    block@0: // L7
        let a#0: uint64 = 3u
        let b#0: uint64 = 20u
        let next_range_item#0: uint64 = 0u
        goto block@1
    block@1: // for_header_L15
        let continue_looping%0#0: bool = (< next_range_item#0 5u)
        goto continue_looping%0#0 ? block@2 : block@4
    block@2: // for_body_L16
        let b#0: uint64 = (+ b#0 a#0)
        let a#0: uint64 = (+ a#0 next_range_item#0)
        let next_range_item#0: uint64 = (+ next_range_item#0 1u)
        goto block@1
    block@4: // after_for_L15
        let tmp%0#0: uint64 = (+ a#0 b#0)
        return tmp%0#0